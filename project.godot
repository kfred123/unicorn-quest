; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to [section] in same-name.cfg file
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unicorn Quest"
config/description="A 2D jump'n'run for children: a girl rides her unicorn through a colorful world, dismounting to explore caves and mounting to jump higher and cast rainbow bridges."
run/main_scene="res://scenes/levels/TestLevel.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input]

move_left={
"deadzone": 0.5,
"events": []
}
move_right={
"deadzone": 0.5,
"events": []
}
jump={
"deadzone": 0.5,
"events": []
}
mount_dismount={
"deadzone": 0.5,
"events": []
}
cast_bridge={
"deadzone": 0.5,
"events": []
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

2d/default_gravity=1400.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
